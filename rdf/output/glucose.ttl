ncit:C120839 skos:definition "The extracellular fluid component found in the spaces between tissues. This excludes plasma and transcellular fluid." ;
    skos:prefLabel "Interstitial Fluid" .

ncit:C12434 skos:altLabel "Reticuloendothelial System, Blood",
        "portion of blood",
        "vertebrate blood" ;
    skos:definition "A liquid tissue with the primary function of transporting oxygen and carbon dioxide. It supplies the tissues with nutrients, removes waste products, and contains various components of the immune system defending the body against infection." ;
    skos:prefLabel "Blood" .

ncit:C13356 skos:definition "The fluid (acellular) portion of the circulating blood with retained clotting components." ;
    skos:prefLabel "Plasma" .

ncit:C50322 skos:definition "A piece of chemically treated medium designed to react in the presence of specific amounts of a trigger substance." ;
    skos:prefLabel "Test Strip Device" .

ncit:C13325 skos:definition "The clear portion of the blood that remains after the removal of the blood cells and the clotting proteins. (NCI)" ;
    skos:prefLabel "Serum" .

ncit:C42576 skos:altLabel "Gram per Cubic Decimeter",
        "Kilogram/Cubic Meter",
        "g/dm3",
        "gram(s)/litre",
        "kilogram / (meter ^ 3)",
        "kilogram per meter cubed",
        "kilogram(s)/cubic meter",
        "microgram(s)/microlitre",
        "milligram(s)/millilitre" ;
    skos:definition "A unit of concentration or mass density equal to one milligram of substance per milliliter of solution or one gram of substance per liter of solution." ;
    skos:prefLabel "Kilogram per Cubic Meter" .

var:LBORRESU a cfa:Variable ;
    skos:notation "LBORRESU" ;
    cfa:facetKind cfa:OpenFacet ;
    cfa:facetPosition cfa:OpenPosition ;
    cfa:inDomain dom:LB ;
    cfa:positionBasis "standards silent, open" ;
    cfa:positionBasisNote "Interpretation_Context in Domain_Behaviour: COSMoS has LBORRESU on 117 of 147 LB DSSs (assigned on 14, value list on 102, no value on 1; COSMoS_Use mixed); it never separates the DSSs of one BC (not in Variable_Evidence); codelist UNIT (C71620). SDTMIG v3.4 Variable Qualifier, Exp. SDTM v2.0: Variable Qualifier of --ORRES, --ORNRLO, --ORNRHI, --ORREF; NCIt concept of --ORRESU: Original Result Unit. SDTMIG v3.4 CDISC Notes: 'Original units in which the data were collected. The unit for LBORRES. Example: \"g/L\".' SDTMIG v3.4 LB Assumption 8: LBORRESU is among 'the aspects of a test that are associated with a LOINC code', 'only required to be populated when necessary to provide a semantically meaningful distinction between records with different LBLOINC values'. The Model ties the unit to the result, LB-A8 to the test. No source says whether this variable is part of the observable. Quoted in SDTMIG_Statements.xlsx: LB-A8. Kind: open — a planned unit names the property of the observable (docs/Observables_Direction.md); a reported unit is the form of the result. The key has no property part." ;
    cfa:positionStatus "proposed" .

var:LBSTRESU a cfa:Variable ;
    skos:notation "LBSTRESU" ;
    cfa:inDomain dom:LB .

ncit:C13283 skos:altLabel "Urinary System, Urine" ;
    skos:definition "The fluid produced by the kidneys." ;
    skos:prefLabel "Urine" .

ncit:C67015 skos:altLabel "Milligram/Deciliter",
        "milligram per 100 milliliters of solution" ;
    skos:definition "A unit of mass concentration defined as the concentration of one milligram of a substance in unit volume of the mixture equal to one cubic deciliter or 100 cubic centimeters. It is also a unit of mass density (volumic mass) defined as the density of substance which mass equal to one milligram occupies the volume one cubic deciliter or 100 cubic centimeters.(NCI)" ;
    skos:prefLabel "Milligram per Deciliter" .

