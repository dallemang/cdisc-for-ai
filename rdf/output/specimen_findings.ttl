var:LB-LBMETHOD a cfa:Variable ;
    skos:notation "LBMETHOD" ;
    cfa:facetKind cfa:ObservableFacet ;
    cfa:facetPosition cfa:Method ;
    cfa:inDomain dom:LB ;
    cfa:isEvidencedBy val:keysource-Variable_Evidence ;
    cfa:positionBasis "sources agree" ;
    cfa:positionBasisNote "COSMoS: predicate SPECIFIES, \"is the method for the test in\", DEC Test Method, codelist METHOD. Fan-out axis method and key part method agree (Key_Compare in Domain_Behaviour). LOINC method agrees where COSMoS separates by method (LOINC_Compare in Domain_Behaviour). SDTM v2.0 and SDTMIG v3.4: Record Qualifier, the same role as --POS and --FAST; the role does not separate them. SDTMIG v3.4 LB Assumption 8: with LBTEST and LBORRESU, 'the aspects of a test that are associated with a LOINC code'. Quoted in SDTMIG_Statements.xlsx: LB-A8. Kind: observable — follows from the position." ;
    cfa:positionStatus "accepted" .

ncit:C125985 a cfa:NCItConcept ;
    skos:definition "A score developed by Allred et al. (1998) and assigned based on the percent positivity of cells for a particular analyte (Allred DC, Harvey JM, Berardo M, Clark GM. Prognostic and predictive factors in breast cancer by immunohistochemical analysis. Mod Pathol. 1998 Feb;11(2):155-68)." ;
    skos:prefLabel "Allred Proportion Positive Score" .

ncit:C125986 a cfa:NCItConcept ;
    skos:definition "A score developed by Allred et al. (1998) and assigned based on the average staining intensity of cells for a particular analyte. (Allred DC, Harvey JM, Berardo M, Clark GM. Prognostic and predictive factors in breast cancer by immunohistochemical analysis. Mod Pathol. 1998 Feb;11(2):155-68)" ;
    skos:prefLabel "Allred Average Staining Intensity Score" .

ncit:C125987 a cfa:NCItConcept ;
    skos:altLabel "Allred Score" ;
    skos:definition "The total score within the Allred scoring system developed by Allred et al. (1998) and based on the sum of the proportion positive score and the staining intensity score. (Allred DC, Harvey JM, Berardo M, Clark GM. Prognostic and predictive factors in breast cancer by immunohistochemical analysis. Mod Pathol. 1998 Feb;11(2):155-68)" ;
    skos:prefLabel "Allred Total Score" .

